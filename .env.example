# Required provider credentials and OpenAI-compatible chat-completions endpoint.
# Replace placeholders locally; do not commit .env or real secrets.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://example.com/v1
LLM_MODEL=your_model_name

# Per HTTP attempt timeout in seconds: finite and > 0 (default 30).
LLM_TIMEOUT_SECONDS=30
# Total attempts including the initial request: integer >= 1 (default 3).
LLM_MAX_ATTEMPTS=3
# Exponential backoff base in seconds: finite and >= 0 (default 1), plus bounded jitter.
LLM_RETRY_BASE_DELAY_SECONDS=1

# Required for Task APIs, Alembic migrations and durable workflow checkpoints.
# Alembic and PostgresSaver setup are separate explicit initialization commands.
DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/agentflow

# Operator recovery inactivity threshold: finite and > 0 seconds (default 300).
# Staleness permits evidence evaluation; it does not enable automatic recovery.
RECOVERY_STALE_AFTER_SECONDS=300
